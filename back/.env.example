# Puerto del API
PORT=4000

# Clave para acceder al panel de administración (header x-admin-key)
ADMIN_KEY=clothea-admin

# Supabase (si se dejan vacíos, el API corre en modo demo con datos en memoria)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Origen permitido para CORS (frontend)
CORS_ORIGIN=http://localhost:3000
